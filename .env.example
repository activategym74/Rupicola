# ===== Supabase (obligatorio) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: invitaciones de usuarios, webhooks de pago y envío de WhatsApp
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces de QR, seguimiento y retorno de pagos)
NEXT_PUBLIC_SITE_URL=https://rupicola.example.com

# ===== Pagos en línea · Wompi (Colombia) — requiere conexión externa =====
# Sin estas variables el método "Pago en línea" queda deshabilitado; no se simulan pagos.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ===== WhatsApp Business Platform (Cloud API) — requiere conexión externa =====
# Sin estas variables los mensajes quedan en la cola como "skipped"; no se marcan como enviados.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER_STATUS=order_status
WHATSAPP_TEMPLATE_LANG=es_CO
# Secreto para invocar /api/notifications/dispatch desde un cron
CRON_SECRET=

# ===== Mapas =====
# OpenStreetMap (Leaflet) funciona sin clave. Opcional: servidor de teselas propio.
NEXT_PUBLIC_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
